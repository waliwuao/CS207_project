<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fpga.ui.CalcModeController">

    <!-- 标题 -->
    <Label style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #f9e2af;" text="MATRIX CALCULATION ENGINE" />

    <!-- 日志/输出显示区域 -->
    <TextArea fx:id="calcLog" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
              style="-fx-control-inner-background: #11111b; -fx-text-fill: #f9e2af; -fx-font-family: 'Consolas', 'Monospaced'; -fx-highlight-fill: #f9e2af; -fx-highlight-text-fill: #11111b;"
              text="Waiting for calculation command..." />

    <!-- 输入框 -->
    <TextField fx:id="inputField" onAction="#onSendCommand" promptText="Enter opcode or value..."
               style="-fx-background-color: #313244; -fx-text-fill: white; -fx-border-color: #45475a; -fx-border-radius: 4;" />

</VBox>