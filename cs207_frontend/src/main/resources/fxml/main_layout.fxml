<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane" prefHeight="600.0" prefWidth="900.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fpga.ui.MainLayoutController">

    <!-- 顶部：标题与当前模式 -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 20; -fx-background-color: #181825;">
            <Label styleClass="title-label" text="FPGA MATRIX CALCULATOR" />
            <StackPane alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                <Label fx:id="currentModeLabel" styleClass="mode-badge" text="DEFAULT" />
            </StackPane>
        </HBox>
    </top>

    <!-- 左侧：连接控制 -->
    <left>
        <VBox prefWidth="240.0" spacing="15.0" styleClass="sidebar">
            <!-- 连接区域 -->
            <Label style="-fx-font-weight: bold; -fx-opacity: 0.7;" text="Connection Settings" />

            <Label text="Select Port:" />
            <ComboBox fx:id="portSelector" prefWidth="200.0" promptText="COM Port" />

            <Button mnemonicParsing="false" onAction="#onConnectClicked" prefWidth="200.0" text="CONNECT" />

            <Label fx:id="statusLabel" style="-fx-text-fill: #6c7086;" text="Status: DISCONNECTED" />

            <Separator style="-fx-opacity: 0.2;" />

            <!-- 模拟发送区域 (默认隐藏或禁用，通过Controller控制可见性) -->
            <VBox fx:id="simulationBox" spacing="10" visible="false" managed="false">
                <Label style="-fx-font-weight: bold; -fx-text-fill: #f9e2af;" text="DEBUG / SIMULATION" />
                <Label text="Simulate FPGA Msg:" style="-fx-font-size: 12px;"/>

                <TextField fx:id="simulationInput" promptText="e.g. Entered SHOW"
                           style="-fx-background-color: #313244; -fx-text-fill: white;" />

                <Button onAction="#onSimulateSend" prefWidth="200.0"
                        style="-fx-background-color: #45475a; -fx-border-color: #f9e2af; -fx-border-radius: 8; -fx-background-radius: 8;"
                        text="Send Mock Data" />

                <Label text="Try: Entered SHOW / Entered CALC" style="-fx-font-size: 10px; -fx-opacity: 0.5;" wrapText="true"/>
            </VBox>

            <VBox VBox.vgrow="ALWAYS" /> <!-- 占位符，把上面的内容顶上去，下面的版本号压下来 -->

            <Label style="-fx-font-size: 10; -fx-opacity: 0.3;" text="v1.1.0 Simulation Ready" />
        </VBox>
    </left>

    <!-- 中心：动态内容区 -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #1e1e2e; -fx-padding: 20;">
            <!-- 默认子页面将加载到这里 -->
        </StackPane>
    </center>

</BorderPane>