<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.fpga.ui.RandomModeController">

    <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #cba6f7;" text="RANDOM GENERATION MODE" />

    <Label style="-fx-text-fill: #a6adc8; -fx-text-alignment: CENTER;"
           text="Input dimensions below.&#10;The FPGA will automatically generate the matrix." />

    <VBox maxWidth="300" spacing="15" style="-fx-background-color: #252535; -fx-padding: 30; -fx-background-radius: 10;">

        <Label text="X Dimension:" style="-fx-text-fill: white;"/>
        <TextField fx:id="xInput" promptText="Enter X" style="-fx-background-color: #313244; -fx-text-fill: white;" />
        <Button onAction="#onSendX" text="Send X" maxWidth="Infinity" style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e;"/>

        <Label text="Y Dimension:" style="-fx-text-fill: white;"/>
        <TextField fx:id="yInput" promptText="Enter Y" style="-fx-background-color: #313244; -fx-text-fill: white;" />
        <Button onAction="#onSendY" text="Send Y" maxWidth="Infinity" style="-fx-background-color: #89b4fa; -fx-text-fill: #1e1e2e;"/>

    </VBox>

    <Label fx:id="logLabel" text="Ready." style="-fx-text-fill: #6c7086;" />

</VBox>